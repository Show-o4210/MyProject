# Supabase 凭据 (用于安全日志；使用 anon key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# 安全管理鉴权 Token (可选，查看安全审计统计)
SECURITY_ADMIN_TOKEN=your-random-secure-admin-token

# 额外的 IP 黑名单 (可选，以英文逗号分隔)
SECURITY_BLOCKED_IPS=1.2.3.4,5.6.7.8

# 可信 IP（可选）：跳过脚本 UA 告警，例如确认后的 Render 出站 IP
# SECURITY_TRUSTED_IPS=74.220.49.7

# 自唤醒：务必指向 /health（安全白名单），勿指向首页 /
SELF_PING_URL=https://your-app-name.onrender.com/health
# 可选：与 security 模块共享的自唤醒 Token（请求头 X-Self-Ping-Token）
# SELF_PING_TOKEN=your-random-self-ping-token
