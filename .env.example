# Canonical public URL for the notice page, robots.txt and sitemap.xml.
SITE_BASE_URL=https://pvz-h-tools.onrender.com
# Optional local listening port; Render sets PORT automatically.
PORT=5001

# Shared across paths, aliases and methods; tune after observing real traffic.
REQUEST_LIMIT_PER_IP="10/second;120/minute"
REQUEST_LIMIT_GLOBAL="120/second;1200/minute"
# Keep false on local/direct deployments. Enable only when a trusted ingress
# overwrites CF-Connecting-IP (Render public ingress); never trust arbitrary XFF.
TRUST_CLOUDFLARE_CLIENT_IP=false
