# Supabase 凭据 (必须，用于反馈和安全日志)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# 安全管理鉴权 Token (可选，查看安全审计统计)
SECURITY_ADMIN_TOKEN=your-random-secure-admin-token

# 额外的 IP 黑名单 (可选，以英文逗号分隔)
SECURITY_BLOCKED_IPS=1.2.3.4,5.6.7.8

# 自唤醒 Ping 目标地址 (可选，防止 Render 实例休眠，默认为生产地址)
SELF_PING_URL=https://your-app-name.onrender.com/

# EA/PopCap 客户端配置 (可选)
PVZH_CLIENT_ID=pvzheroes-2015-google-client
PVZH_CLIENT_VERSION=1.64.6
PVZH_CONTENT_VERSION=45a337051e72592e53c9bf8a4b590639
PVZH_PLATFORM=Android
PVZH_REQUEST_TIMEOUT=12
